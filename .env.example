# Учётные данные для входа в веб-интерфейс
ADMIN_USER=admin
ADMIN_PASS=

# IP этого сервера (куда переключать DNS при восстановлении)
HOST_IP=

# Внешний порт restore-manager
RESTORE_PORT=9443

# Пути на хосте
HOST_BACKUP_ROOT=/root/remnawave-backups
REMNAWAVE_DIR=/opt/remnawave
BOT_DIR=/root/remnawave-bedolaga-telegram-bot
CABINET_DIR=/root/bedolaga-cabinet
